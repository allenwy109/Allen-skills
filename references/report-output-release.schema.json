{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Allen report output release record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "schema", "status", "releasedAt", "implementationHead", "provenance",
    "capabilities", "evidence", "a4", "deck", "scenarios", "verification", "review"
  ],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "schema": {"const": "references/report-output-release.schema.json"},
    "status": {"enum": ["pending-verification", "approved"]},
    "releasedAt": {"type": ["string", "null"]},
    "implementationHead": {"type": "string", "pattern": "^[0-9a-f]{7,40}$"},
    "provenance": {"type": "object"},
    "capabilities": {"type": "object"},
    "evidence": {"type": "object"},
    "a4": {"type": "object"},
    "deck": {"type": "object"},
    "scenarios": {"type": "object"},
    "verification": {"type": "object"},
    "review": {"type": "string"}
  }
}
