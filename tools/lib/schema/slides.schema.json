{
 "version": "1.1.0",
 "comment": "07_storyline/slides.json 的结构（设计 §5.3）。在 storyline 上游 slides.json 的基础上，增加报告引擎需要的逐页字段。哪些页必须填哪些字段，由 storyline check 按页面角色检查（计划 5），这里只管结构。",
 "upstream": "storyline 的 slides-schema（inventory/storyline.md E 节）；report-forge deck-blueprint 的 slides 字段（inventory/storyline.md H 节）",
 "changes": ["card_ids 的格式由 C001 改为 card-0001", "页面类型补充 risk 和 close", "新增 page_role、story_beat、proves、adds、claim_refs、metric_refs、density、visual_intent、chart_spec_file（交给 out-chart 的图表 spec，存为 07_storyline/charts/*.json）、block_ids", "deck 新增 story_mode、arc、arc_reason、decision、ratio", "1.1.0：补充报告引擎 narrative-focus-1 要求的字段——deck 新增 brief、answer_claim_refs、cover；页面新增 subtitle（口径副标题）、panels、relations、anchor_panel（组合证据）；evidence_role 补充 evidence"],
 "enums": {
  "deck_kind": {"values": ["presentation", "reading"], "labels": {"presentation": "演讲型", "reading": "阅读型"}},
  "closing_type": {"values": ["recommendation", "next_steps", "decision_request"], "labels": {"recommendation": "建议", "next_steps": "下一步", "decision_request": "请求决策"}},
  "story_mode": {"values": ["problem_to_solution", "option_comparison", "request_approval", "progress_report", "opportunity", "retrospective", "industry_research", "company_research", "diligence_conclusion"], "labels": {"problem_to_solution": "问题诊断→方案", "option_comparison": "方案比选", "request_approval": "请求批准", "progress_report": "进展汇报", "opportunity": "机会论证", "retrospective": "复盘", "industry_research": "行业研究", "company_research": "公司研究", "diligence_conclusion": "尽调结论"}},
  "arc": {"values": ["opportunity-to-choice", "problem-to-fix", "uncertainty-to-bet", "evidence-to-view", "other"], "labels": {"opportunity-to-choice": "机会到选择", "problem-to-fix": "问题到解决", "uncertainty-to-bet": "不确定到下注", "evidence-to-view": "证据到观点", "other": "其他"}},
  "ratio": {"values": ["16x9", "4x3"], "labels": {"16x9": "16:9", "4x3": "4:3"}},
  "page_type": {"values": ["cover", "toc", "executive_summary", "section_divider", "point_evidence", "data_chart", "comparison", "process", "timeline", "matrix", "case", "recommendation", "next_steps", "risk", "backup", "appendix", "close"], "labels": {"cover": "封面", "toc": "目录", "executive_summary": "执行摘要", "section_divider": "章节过渡", "point_evidence": "观点+证据", "data_chart": "数据图表", "comparison": "对比", "process": "流程", "timeline": "时间线", "matrix": "矩阵", "case": "案例", "recommendation": "建议", "next_steps": "下一步", "risk": "风险", "backup": "备用", "appendix": "附录", "close": "结尾"}},
  "page_role": {"values": ["cover", "section", "analysis", "decision", "action", "risk", "appendix", "close"], "labels": {"cover": "封面", "section": "章节", "analysis": "分析", "decision": "决策", "action": "行动", "risk": "风险", "appendix": "附录", "close": "封底"}},
  "story_beat": {"values": ["context", "tension", "diagnosis", "insight", "choice", "action", "risk", "close"], "labels": {"context": "情境", "tension": "冲突", "diagnosis": "诊断", "insight": "洞察", "choice": "选择", "action": "行动", "risk": "风险", "close": "收尾"}},
  "chart_relationship": {"values": ["component", "item_ranking", "time_series", "frequency_distribution", "correlation"], "labels": {"component": "成分", "item_ranking": "项目排序", "time_series": "时间序列", "frequency_distribution": "频率分布", "correlation": "相关性"}},
  "density_profile": {"values": ["dense", "balanced", "sparse"], "labels": {"dense": "密", "balanced": "均衡", "sparse": "疏"}},
  "evidence_role": {"values": ["primary", "support", "context", "evidence", "implication"], "labels": {"primary": "主展品", "support": "支持", "context": "背景", "evidence": "证据", "implication": "含义"}},
  "brief_purpose": {"values": ["diagnosis", "decision", "research"], "labels": {"diagnosis": "诊断", "decision": "决策", "research": "研究"}},
  "relation_kind": {"values": ["compare", "decompose", "sequence", "complement", "overview-detail", "boundary", "other"], "labels": {"compare": "对照", "decompose": "拆解", "sequence": "递进", "complement": "互补", "overview-detail": "总览与细节", "boundary": "边界", "other": "其他"}}
 },
 "root": {
  "type": "object",
  "fields": {
   "deck": {
    "type": "object", "required": true,
    "fields": {
     "title": {"type": "string", "required": true},
     "kind": {"type": "string", "enum": "deck_kind", "required": true},
     "language": {"type": "string", "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$", "required": true},
     "audience": {"type": "string"},
     "decision": {"type": "string"},
     "duration_minutes": {"type": "integer", "min": 1},
     "page_limit": {"type": "integer", "min": 1},
     "content_page_count": {"type": "integer", "min": 0},
     "closing_type": {"type": "string", "enum": "closing_type"},
     "story_mode": {"type": "string", "enum": "story_mode", "required": true},
     "arc": {"type": "string", "enum": "arc", "required": true},
     "arc_reason": {"type": "string"},
     "ratio": {"type": "string", "enum": "ratio"},
     "generated_from": {"type": "string"},
     "confidentiality": {"type": "string"},
     "brief": {"type": "object", "fields": {
      "question": {"type": "string", "required": true},
      "purpose": {"type": "string", "enum": "brief_purpose", "required": true},
      "scope": {"type": "string", "required": true},
      "period": {"type": "string", "required": true},
      "baseline": {"type": "string", "required": true},
      "constraints": {"type": "string", "required": true},
      "success_criteria": {"type": "string", "required": true}}},
     "answer_claim_refs": {"type": "array", "items": {"type": "string", "pattern": "^cl-[0-9]{4,}$"}},
     "decision_structure": {"type": "object", "required": true, "fields": {
      "decision_level": {"type": "string", "required": true},
      "decisive_reasons": {"type": "array", "required": true, "min_items": 3, "max_items": 3, "items": {"type": "string"}},
      "largest_upside": {"type": "string", "required": true},
      "largest_risk": {"type": "string", "required": true},
      "immediate_actions": {"type": "array", "required": true, "min_items": 1, "items": {"type": "string"}},
      "thresholds": {"type": "object", "required": true, "fields": {
       "continue": {"type": "string", "required": true},
       "stop": {"type": "string", "required": true}
      }}
     }},
     "cover": {"type": "object", "fields": {
      "subtitle": {"type": "string"},
      "producer": {"type": "string"},
      "date": {"type": "date"},
      "version": {"type": "string"},
      "project": {"type": "string"},
      "client": {"type": "string"},
      "access": {"type": "string"},
      "statement": {"type": "string"},
      "closing_text": {"type": "string"}}}
    }
   },
   "slides": {
    "type": "array", "required": true, "min_items": 1,
    "items": {
     "type": "object",
     "fields": {
      "page": {"type": "integer", "min": 1, "required": true},
      "type": {"type": "string", "enum": "page_type", "required": true},
      "action_title": {"type": "string", "required": true},
      "section": {"type": "string"},
      "body": {"type": "array", "items": {"type": "object", "fields": {"text": {"type": "string", "required": true}, "card_ids": {"type": "array", "items": {"type": "string", "pattern": "^card-[0-9]{4,}$"}}}}},
      "chart": {"type": "object", "fields": {
       "relationship": {"type": "string", "enum": "chart_relationship", "required": true},
       "chart_type": {"type": "string", "required": true},
       "rationale": {"type": "string"},
       "data_fields": {"type": "array", "items": {"type": "object", "fields": {"field": {"type": "string", "required": true}, "value": {"type": "string", "required": true}, "unit": {"type": "string"}, "card_id": {"type": "string", "pattern": "^card-[0-9]{4,}$"}, "metric_ref": {"type": "string", "pattern": "^m-[0-9]{4,}$"}}}},
       "highlight": {"type": "string"},
       "axis_notes": {"type": "string"}}},
      "notes": {"type": "string"},
      "sources": {"type": "array", "items": {"type": "object", "fields": {"card_id": {"type": "string", "pattern": "^card-[0-9]{4,}$", "required": true}, "locator": {"type": "string"}}}},
      "traceback": {"type": "object", "fields": {"manuscript_section": {"type": "string"}, "card_ids": {"type": "array", "items": {"type": "string", "pattern": "^card-[0-9]{4,}$"}}}},
      "backup": {"type": "object", "fields": {"question": {"type": "string", "required": true}, "trigger": {"type": "string", "required": true}}},
      "page_role": {"type": "string", "enum": "page_role", "required": true},
      "story_beat": {"type": "string", "enum": "story_beat", "required": true},
      "proves": {"type": "string"},
      "adds": {"type": "string"},
      "adds_overlap_reason": {"type": "string"},
      "claim_refs": {"type": "array", "items": {"type": "string", "pattern": "^cl-[0-9]{4,}$"}},
      "metric_refs": {"type": "array", "items": {"type": "string", "pattern": "^m-[0-9]{4,}$"}},
      "density": {"type": "object", "fields": {
       "profile": {"type": "string", "enum": "density_profile", "required": true},
       "evidence_units": {"type": "array", "items": {"type": "object", "fields": {"role": {"type": "string", "enum": "evidence_role", "required": true}, "purpose": {"type": "string", "required": true}}}, "min_items": 1, "required": true},
       "space_intent": {"type": "string", "required": true},
       "sparse_reason": {"type": "string"}}},
      "visual_intent": {"type": "object", "fields": {
       "relationship": {"type": "string", "required": true},
       "form": {"type": "string", "required": true},
       "primary": {"type": "string"},
       "alternatives": {"type": "array", "items": {"type": "object", "fields": {"form": {"type": "string", "required": true}, "tradeoff": {"type": "string", "required": true}}}},
       "reading_path": {"type": "string"},
       "layout": {"type": "string"},
       "layout_reason": {"type": "string"},
       "repetition_reason": {"type": "string"},
       "semantic_type": {"type": "string"}}},
      "chart_spec_file": {"type": "string", "pattern": "^charts/[A-Za-z0-9_.-]+\\.json$"},
      "block_ids": {"type": "array", "items": {"type": "string"}},
      "subtitle": {"type": "string"},
      "anchor_panel": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
      "panels": {"type": "array", "items": {"type": "object", "fields": {
       "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$", "required": true},
       "purpose": {"type": "string", "required": true},
       "claim_refs": {"type": "array", "items": {"type": "string", "pattern": "^cl-[0-9]{4,}$"}, "min_items": 1, "required": true},
       "form": {"type": "string", "required": true},
       "relationship": {"type": "string", "required": true},
       "reason": {"type": "string", "required": true},
       "alternative": {"type": "string"},
       "tradeoff": {"type": "string"},
       "capacity": {"type": "map", "values": {"type": "integer", "min": 0}},
       "semantic_type": {"type": "string"},
       "visual": {"type": "string"},
       "source_ids": {"type": "array", "items": {"type": "string"}},
       "slot": {"type": "string"},
       "role": {"type": "string", "enum": "evidence_role", "required": true},
       "span": {"type": "number", "min": 0}}}},
      "relations": {"type": "array", "items": {"type": "object", "fields": {
       "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$", "required": true},
       "kind": {"type": "string", "enum": "relation_kind", "required": true},
       "panel_refs": {"type": "array", "items": {"type": "string"}, "min_items": 2, "required": true},
       "reason": {"type": "string", "required": true}}}}
     }
    }
   }
  }
 }
}
