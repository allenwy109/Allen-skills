{
  "version": "1.0.0",
  "comment": "Review issue repair and re-review contract.",
  "enums": {
    "severity": {"values": ["blocking", "major", "minor"], "labels": {"blocking": "阻断", "major": "重大", "minor": "轻微"}},
    "review_status": {"values": ["open", "closed"], "labels": {"open": "未关闭", "closed": "已关闭"}}
  },
  "root": {
    "type": "object",
    "fields": {
      "version": {"type": "integer", "required": true, "min": 1, "max": 1},
      "issues": {"type": "array", "required": true, "items": {
        "type": "object",
        "fields": {
          "id": {"type": "string", "required": true},
          "reviewer": {"type": "string", "required": true},
          "severity": {"type": "string", "required": true, "enum": "severity"},
          "location": {"type": "string", "required": true},
          "remedy": {"type": "string"},
          "remedy_evidence": {"type": "array", "required": true, "items": {"type": "string"}},
          "re_reviewer": {"type": "string"},
          "status": {"type": "string", "required": true, "enum": "review_status"}
        }
      }}
    }
  }
}
