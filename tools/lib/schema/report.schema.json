{
 "version": "1.0.0",
 "comment": "媒介无关的 A4 报告内容合同；coverage manifest 由 bridge 单独返回。",
 "enums": {
  "block_kind": {"values": ["chart", "text", "metric", "table"], "labels": {"chart": "图表", "text": "文字", "metric": "指标", "table": "表格"}},
  "block_form": {"values": ["svg.custom", "html.text", "html.kpi", "html.table"], "labels": {"svg.custom": "自定义矢量图", "html.text": "文字", "html.kpi": "指标", "html.table": "表格"}},
  "claim_identity": {"values": ["fact", "data", "estimate", "forecast", "assumption", "judgment", "recommendation", "third_party_view"], "labels": {"fact": "事实", "data": "数据", "estimate": "估算", "forecast": "预测", "assumption": "假设", "judgment": "判断", "recommendation": "建议", "third_party_view": "第三方观点"}},
  "panel_role": {"values": ["primary", "support", "context", "evidence", "implication"], "labels": {"primary": "主展品", "support": "支持", "context": "背景", "evidence": "证据", "implication": "含义"}}
  ,"exhibit_kind": {"values": ["executive-summary", "answer-and-reasons", "pain-comparison", "competitor-matrix", "decision-tree", "mechanism-process", "paired-scenarios", "30-60-90-roadmap", "methods-limitations", "point_evidence"], "labels": {"executive-summary":"执行摘要","answer-and-reasons":"答案与理由","pain-comparison":"痛点比较","competitor-matrix":"竞品矩阵","decision-tree":"决策树","mechanism-process":"机制流程","paired-scenarios":"成对情景","30-60-90-roadmap":"三阶段路线图","methods-limitations":"方法与限制","point_evidence":"要点证据"}}
  ,"exhibit_family": {"values": ["chart", "process", "timeline", "matrix", "scenario", "decision-tree", "point_evidence"], "labels": {"chart":"图表","process":"流程","timeline":"时间线","matrix":"矩阵","scenario":"情景","decision-tree":"决策树","point_evidence":"要点证据"}}
 },
 "root": {
  "type": "object",
  "fields": {
   "version": {"type": "string", "pattern": "^1\\.0\\.0$", "required": true},
   "metadata": {"type": "object", "required": true, "fields": {
    "title": {"type": "string", "required": true},
    "language": {"type": "string", "required": true},
    "audience": {"type": "string"},
    "decision": {"type": "string"},
    "date": {"type": "date"},
    "bibliography_policy": {"type": "string", "required": true},
    "client_citations": {"type": "string", "required": true}
   }},
   "executive_summary": {"type": "object", "required": true, "fields": {
    "question": {"type": "string", "required": true},
    "answer_claim_refs": {"type": "array", "required": true, "items": {"type": "string"}},
    "a_card_refs": {"type": "array", "required": true, "items": {"type": "string"}}
   }},
   "registry": {"type": "object", "required": true, "fields": {
    "claim_ids": {"type": "array", "required": true, "items": {"type": "string"}},
    "metric_ids": {"type": "array", "required": true, "items": {"type": "string"}},
    "source_ids": {"type": "array", "required": true, "items": {"type": "string"}},
    "card_ids": {"type": "array", "required": true, "items": {"type": "string"}},
    "panel_ids": {"type": "array", "required": true, "items": {"type": "string"}},
    "relation_ids": {"type": "array", "required": true, "items": {"type": "string"}}
   }},
   "citation_registry": {"type": "array", "items": {"type": "object", "fields": {
    "source_id": {"type": "string", "required": true},
    "number": {"type": "integer", "min": 1, "required": true},
    "appendix_anchor": {"type": "string", "required": true}
   }}},
   "sections": {"type": "array", "required": true, "items": {"type": "object", "fields": {
    "id": {"type": "string", "required": true},
    "title": {"type": "string", "required": true},
    "blocks": {"type": "array", "required": true, "items": {"type": "object", "fields": {
     "id": {"type": "string", "required": true},
     "kind": {"type": "string", "enum": "block_kind", "required": true},
     "claim_refs": {"type": "array", "required": true, "items": {"type": "string"}},
     "metric_refs": {"type": "array", "required": true, "items": {"type": "string"}},
     "source_ids": {"type": "array", "required": true, "items": {"type": "string"}},
     "source_bindings": {"type": "array", "required": true, "items": {"type": "object", "fields": {
      "source_id": {"type": "string", "required": true},
      "locators": {"type": "array", "required": true, "items": {"type": "string"}}
     }}},
     "panel_refs": {"type": "array", "required": true, "items": {"type": "string"}},
     "relation_refs": {"type": "array", "required": true, "items": {"type": "string"}},
     "identity": {"type": "array", "required": true, "items": {"type": "string", "enum": "claim_identity"}},
     "content": {"type": "object", "required": true, "fields": {
      "title": {"type": "string", "required": true},
      "subtitle": {"type": "string"},
      "purpose": {"type": "string", "required": true},
      "form": {"type": "string", "enum": "block_form", "required": true},
      "relationship": {"type": "string", "required": true},
      "reason": {"type": "string", "required": true},
      "anchor": {"type": "boolean", "required": true},
      "role": {"type": "string", "enum": "panel_role", "required": true},
      "alternative": {"type": "string"},
      "tradeoff": {"type": "string"},
      "capacity": {"type": "map", "values": {"type": "integer", "min": 0}},
      "semantic_type": {"type": "string"},
      "exhibit": {"type": "object", "require_if": [
       {"if":{"field":"kind","in":["executive-summary","answer-and-reasons"]},"then":["answer","reasons"],"message":"答案类展品需要答案与理由"},
       {"if":{"field":"kind","in":["pain-comparison","competitor-matrix"]},"then":["columns","rows"],"message":"矩阵类展品需要列和行"},
       {"if":{"field":"kind","equals":"decision-tree"},"then":["nodes","edges"],"message":"决策树需要节点与边"},
       {"if":{"field":"kind","equals":"mechanism-process"},"then":["steps"],"message":"流程需要步骤"},
       {"if":{"field":"kind","equals":"paired-scenarios"},"then":["scenarios"],"message":"情景展品需要成对情景"},
       {"if":{"field":"kind","equals":"30-60-90-roadmap"},"then":["stages"],"message":"路线图需要阶段"},
       {"if":{"field":"kind","equals":"methods-limitations"},"then":["methods","limitations"],"message":"方法展品需要方法与限制"}
      ], "fields": {
       "kind": {"type": "string", "enum": "exhibit_kind", "required": true},
       "family": {"type": "string", "enum": "exhibit_family", "required": true},
       "form": {"type": "string", "enum": "block_form", "required": true},
       "selected_layout": {"type": "string", "enum": "exhibit_kind", "required": true},
       "layout_reason": {"type": "string", "required": true},
       "capacity_state": {"type": "string", "required": true},
       "answer": {"type": "string"},
       "reasons": {"type": "array", "min_items": 1, "items": {"type": "string"}},
       "columns": {"type": "array", "min_items": 1, "items": {"type": "string"}},
       "rows": {"type": "array", "min_items": 1, "items": {"type": "object", "fields": {"label":{"type":"string","required":true},"values":{"type":"array","required":true,"min_items":1,"items":{"type":"string"}}}}},
       "nodes": {"type": "array", "min_items": 2, "items": {"type": "object", "fields": {"id":{"type":"string","required":true},"label":{"type":"string","required":true}}}},
       "edges": {"type": "array", "min_items": 1, "items": {"type": "object", "fields": {"from":{"type":"string","required":true},"to":{"type":"string","required":true},"label":{"type":"string","required":true}}}},
       "steps": {"type": "array", "min_items": 2, "items": {"type": "object", "fields": {"label":{"type":"string","required":true}}}},
       "scenarios": {"type": "array", "min_items": 2, "max_items": 2, "items": {"type": "object", "fields": {"label":{"type":"string","required":true},"outcome":{"type":"string","required":true}}}},
       "stages": {"type": "array", "min_items": 3, "max_items": 3, "items": {"type": "object", "fields": {"label":{"type":"string","required":true},"output":{"type":"string","required":true}}}},
       "methods": {"type": "array", "min_items": 1, "items": {"type": "string"}},
       "limitations": {"type": "array", "min_items": 1, "items": {"type": "string"}}
      }},
      "visual": {"type": "string"},
      "slot": {"type": "string", "required": true},
      "span": {"type": "number", "min": 0, "required": true},
      "claims": {"type": "array", "items": {"type": "object", "fields": {
       "id": {"type": "string", "required": true},
       "statement": {"type": "string", "required": true},
       "identity": {"type": "string", "enum": "claim_identity", "required": true},
       "confidence": {"type": "string", "required": true},
       "scope": {"type": "string", "required": true},
       "limitation": {"type": "string", "required": true},
       "support_label": {"type": "string", "required": true},
       "support": {"type": "array", "required": true, "items": {"type": "object", "fields": {
        "source_id": {"type": "string", "required": true}, "locator": {"type": "string", "required": true}, "excerpt": {"type": "string", "required": true}
       }}},
       "counter": {"type": "array", "required": true, "items": {"type": "object", "fields": {
        "source_id": {"type": "string", "required": true}, "locator": {"type": "string", "required": true}, "excerpt": {"type": "string", "required": true}
       }}}
      }}},
      "pain_groups": {"type": "array", "items": {"type": "object", "fields": {
       "segment": {"type": "string", "required": true}, "trigger": {"type": "string", "required": true},
       "workaround": {"type": "string", "required": true}, "consequence": {"type": "string", "required": true},
       "purchase_signal": {"type": "string", "required": true}, "evidence_strength": {"type": "string", "required": true},
       "counter": {"type": "string", "required": true}, "validation_gap": {"type": "string", "required": true}
      }}},
      "comparison": {"type": "object", "fields": {
       "criteria": {"type": "array", "required": true, "items": {"type": "string"}},
       "alternatives": {"type": "array", "required": true, "items": {"type": "object", "fields": {
        "name": {"type": "string", "required": true}, "layer": {"type": "string", "required": true},
        "values": {"type": "map", "required": true, "values": {"type": "string"}}
       }}}
      }}
     }}
    }}},
    "relations": {"type": "array", "required": true, "items": {"type": "object", "fields": {
     "id": {"type": "string", "required": true},
     "kind": {"type": "string", "required": true},
     "panel_refs": {"type": "array", "required": true, "min_items": 2, "items": {"type": "string"}},
     "reason": {"type": "string", "required": true}
    }}}
   }}},
   "references": {"type": "array", "required": true, "items": {"type": "object", "fields": {
    "id": {"type": "string", "required": true},
    "title": {"type": "string", "required": true},
    "url": {"type": "string"},
    "origin": {"type": "string", "required": true},
    "author": {"type": "string"},
    "publisher": {"type": "string"},
    "published": {"type": "date"},
    "accessed": {"type": "datetime"},
    "grade": {"type": "string"},
    "conflict_of_interest": {"type": "string"},
    "locators": {"type": "array", "required": true, "items": {"type": "string"}}
   }}},
   "appendix": {"type": "array", "required": true, "items": {"type": "object", "fields": {
    "id": {"type": "string", "required": true},
    "title": {"type": "string", "required": true}
   }}}
  }
 }
}
