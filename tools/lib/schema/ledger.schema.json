  "reading": {"values": ["unread", "partial", "analyzed"], "labels": {"unread": "未读", "partial": "部分已读", "analyzed": "已分析"}},
  "relevance": {"values": ["direct", "limited", "excluded"], "labels": {"direct": "直接相关", "limited": "有限相关", "excluded": "排除"}},
  "search_status": {"values": ["not_executed", "found", "not_found", "access_blocked", "failed"], "labels": {"not_executed": "未执行", "found": "找到", "not_found": "未找到", "access_blocked": "访问受阻", "failed": "失败"}},
  "event_coverage": {"values": ["pending", "covered", "lagging", "not_applicable"], "labels": {"pending": "待查", "covered": "已覆盖", "lagging": "滞后", "not_applicable": "不适用"}},
