  "discard_reason": {"values": ["irrelevant", "low_quality", "duplicate", "snippet_only"], "labels": {"irrelevant": "无关", "low_quality": "低质", "duplicate": "重复", "snippet_only": "只有摘要"}}
 },
 "tables": {
  "project": {
   "file": "project.jsonl",
   "id_pattern": "^project$",
   "upstream": "due-diligence G4 project-config；deep-research C2 package.json 的状态字段",
   "changes": ["只有一条记录，id 固定为 project", "depth 拆为 route_depth（router 的 L1–L3）和 diligence_depth（尽调的 Quick/Standard/Deep）", "contract_version、version 不再需要：版本由本 schema 的 version 表示", "target、target_id 改为 target_name、target_entity_id", "新增 joint_control_triggers（尽调优化 2）", "新增 data_status、search_status 及理由（来自 deep-research package.json）"],
   "fields": {
    "id": {"type": "string", "required": true},
    "question": {"type": "string"},
    "route_depth": {"type": "string", "enum": "route_depth"},
    "purpose": {"type": "string", "enum": "purpose"},
    "purpose_status": {"type": "string", "enum": "purpose_status"},
    "diligence_depth": {"type": "string", "enum": "diligence_depth"},
    "target_name": {"type": "string"},
    "target_entity_id": {"type": "string", "ref": "entities"},
    "geography": {"type": "array", "items": {"type": "string"}},
    "focus": {"type": "string"},
    "materials": {"type": "array", "items": {"type": "string"}},
    "as_of_date": {"type": "date"},
    "timezone": {"type": "string"},
    "historical": {"type": "boolean"},
    "information_cutoff": {"type": "date"},
    "constraints": {"type": "object", "fields": {"network": {"type": "string", "enum": "network"}, "budget": {"type": "string"}, "deadline": {"type": "string"}, "permissions": {"type": "array", "items": {"type": "string"}}}},
    "identity_status": {"type": "string", "enum": "identity_status"},
    "listing_trigger": {"type": "string", "enum": "listing_trigger"},
    "control_chain_checked": {"type": "boolean"},
    "control_evidence_ids": {"type": "array", "items": {"type": "string", "ref": "evidence"}},
    "joint_control_triggers": {"type": "boolean"},
    "industry_keywords": {"type": "array", "items": {"type": "string"}},
    "languages": {"type": "array", "items": {"type": "string"}},
    "events": {"type": "array", "items": {"type": "object", "fields": {"date": {"type": "date", "required": true}, "entity_id": {"type": "string", "ref": "entities", "required": true}, "event_type": {"type": "string", "required": true}, "description": {"type": "string", "required": true}}}},
    "peer_required": {"type": "boolean"},
    "category_exemptions": {"type": "array", "items": {"type": "object", "fields": {"entity_id": {"type": "string", "ref": "entities", "required": true}, "category": {"type": "string", "enum": "research_category", "required": true}, "reason": {"type": "string", "required": true}, "evidence_ids": {"type": "array", "items": {"type": "string", "ref": "evidence"}}}}},
    "module_scope": {"type": "map", "key_pattern": "^(0[1-9]|1[0-8])$", "values": {"type": "object", "fields": {"status": {"type": "string", "enum": "module_status", "required": true}, "reason": {"type": "string"}}}},
    "completed_actions": {"type": "array", "items": {"type": "object", "fields": {"action": {"type": "string", "required": true}, "status": {"type": "string", "enum": "action_status", "required": true}, "evidence_ids": {"type": "array", "items": {"type": "string", "ref": "evidence"}}, "output_locator": {"type": "string"}}}},
    "research_gate": {"type": "string", "enum": "gate"},
    "report_status": {"type": "string", "enum": "report_status"},
    "declared_complete": {"type": "boolean"},
    "completion_review": {"type": "object", "fields": {"scope": {"type": "string", "required": true}, "key_claim_ids": {"type": "array", "items": {"type": "string", "ref": "claims"}}, "gap_assessments": {"type": "array", "items": {"type": "object", "fields": {"gap_id": {"type": "string", "ref": "gaps", "required": true}, "impact": {"type": "string", "required": true}, "disposition": {"type": "string", "enum": "gap_disposition", "required": true}}}}, "reviewed_at": {"type": "datetime", "required": true}}},
    "scoring_enabled": {"type": "boolean"},
    "scoring_threshold": {"type": "number", "min": 0, "max": 1},
    "scoring_override": {"type": "object", "fields": {"reason": {"type": "string", "required": true}, "weights": {"type": "map", "values": {"type": "number", "min": 0}}, "critical_dimensions": {"type": "array", "items": {"type": "string", "enum": "scorecard_dimension"}}}},
    "published_score": {"type": "number"},
    "last_refresh_at": {"type": "datetime"},
    "confidentiality": {"type": "string"},
    "data_status": {"type": "string", "enum": "data_status"},
    "data_reason": {"type": "string"},
    "search_status": {"type": "string", "enum": "search_applicability"},
    "search_reason": {"type": "string"}
   },
   "require_if": [
    {"if": {"field": "purpose_status", "equals": "confirmed"}, "then": ["purpose"], "message": "目的已确认时必须写 purpose"},
    {"if": {"field": "report_status", "equals": "complete"}, "then": ["completion_review"], "message": "约定范围完成必须带 completion_review"},
    {"if": {"field": "data_status", "present": true}, "then": ["data_reason"], "message": "写了 data_status 就要写理由"},
    {"if": {"field": "search_status", "present": true}, "then": ["search_reason"], "message": "写了 search_status 就要写理由"}
   ]
  },
  "sources": {
   "file": "sources.jsonl",
   "id_pattern": "^[ABD-Z][0-9]{3,4}$",
   "snapshot_fields": ["id", "title", "url", "final_url", "accessed", "capture_method", "access", "original_files", "language", "research_line", "subquestions", "supersedes", "archive_url", "access_note", "rights_note"],
   "upstream": "deep-research C3 快照头 21 字段；due-diligence G3 source-register",
   "changes": ["source_type（一手/二手/三手）改名为 tier；due-diligence 的 source_type（官方/券商……）保留原名", "credibility（A/B/C）并入 grade（S–D），映射见 core-evidence/references/source-tiers.md", "completeness 与 access_status 合并为 access，统一用下划线", "author_org 与 publisher 都保留：前者是作者或机构，后者是发布平台", "sha256（只记第一个原件）改为 original_files 里逐个记录 sha256（研究优化 3）", "published 允许为空并用 published_precision 记录精度（尽调优化 3）", "新增 origin、internal、duplicate_of、snapshot", "accessed_date 与 accessed 合并为 accessed（datetime）", "checksum 并入 original_files", "due-diligence 的 locator 拆为 url（网页）和 original_files（本地文件）；证据的定位在 evidence.locator"],
   "fields": {
    "id": {"type": "string", "required": true},
    "origin": {"type": "string", "enum": "origin", "required": true},
    "title": {"type": "string", "required": true},
    "url": {"type": "string"},
    "final_url": {"type": "string"},
    "author_org": {"type": "string"},
    "publisher": {"type": "string"},
    "published": {"type": "date"},
    "published_precision": {"type": "string", "enum": "date_precision", "required": true},
    "revised_date": {"type": "date"},
    "accessed": {"type": "datetime", "required": true},
    "language": {"type": "string"},
    "tier": {"type": "string", "enum": "tier", "required": true},
    "grade": {"type": "string", "enum": "grade", "required": true},
    "grade_reason": {"type": "string"},
    "source_type": {"type": "string", "enum": "source_type"},
    "conflict_of_interest": {"type": "string"},
    "capture_method": {"type": "string", "enum": "capture_method", "required": true},
    "access": {"type": "string", "enum": "access", "required": true},
    "original_files": {"type": "array", "items": {"type": "object", "fields": {"path": {"type": "string", "required": true}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$", "required": true}}}},
    "snapshot": {"type": "string"},
    "research_line": {"type": "string", "pattern": "^[ABD-Z]$"},
    "subquestions": {"type": "array", "items": {"type": "string"}},
    "supersedes": {"type": "string", "ref": "sources"},
    "duplicate_of": {"type": "string", "ref": "sources"},
    "archive_url": {"type": "string"},
    "access_note": {"type": "string"},
    "rights_note": {"type": "string"},
    "origin_group": {"type": "string"},
    "upstream_source_id": {"type": "string", "ref": "sources"},
    "authenticity": {"type": "string", "enum": "authenticity"},
    "authorization": {"type": "string"},
    "time_scope": {"type": "string", "enum": "time_scope"},
    "internal": {"type": "boolean"}
   },
   "require_if": [
    {"if": {"field": "published_precision", "in": ["day", "month", "year"]}, "then": ["published"], "message": "发布日期精度不是 unknown 时必须写 published"},
    {"if": {"field": "origin", "equals": "web"}, "then": ["url"], "message": "联网来源必须有 url"}
   ]
  },
  "evidence": {
   "file": "evidence.jsonl",
   "id_pattern": "^ev-[0-9]{4,}$",
   "upstream": "due-diligence G3 evidence-ledger；deep-research C5 notes 证据块",
   "changes": ["两者合并为一张表；notes/*.md 由 ledger render 生成", "笔记块的“论断”改名 claim_text，“解读”改名 interpretation，“用于”改名 used_in，“交叉来源”改名 cross_sources", "笔记块的“置信度”改名 fit，只描述摘录与原文和论断的贴合度；主张的置信度在 claims.confidence"],
   "fields": {
    "id": {"type": "string", "required": true},
    "source_id": {"type": "string", "ref": "sources", "required": true},
    "locator": {"type": "string", "required": true},
    "excerpt": {"type": "string", "required": true},
    "claim_text": {"type": "string"},
    "interpretation": {"type": "string"},
    "entity_id": {"type": "string", "ref": "entities"},
    "module": {"type": "string", "pattern": "^(0[1-9]|1[0-8])$"},
    "attribute": {"type": "string", "enum": "attribute", "required": true},
    "numeric": {"type": "boolean", "required": true},
    "value": {"type": "number"},
