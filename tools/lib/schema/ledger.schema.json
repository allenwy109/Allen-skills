  "scorecard_dimension": {"values": ["business", "growth", "governance", "financial", "compliance", "technology", "operations", "deal"], "labels": {"business": "业务", "growth": "增长", "governance": "治理", "financial": "财务", "compliance": "合规", "technology": "技术", "operations": "运营", "deal": "交易"}},
  "applicability": {"values": ["applicable", "not_applicable"], "labels": {"applicable": "适用", "not_applicable": "不适用"}},
