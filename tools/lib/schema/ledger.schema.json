  "gap_reason": {"values": ["not_disclosed", "not_found", "access_restricted", "unreadable", "not_executed", "not_applicable"], "labels": {"not_disclosed": "未披露", "not_found": "未找到", "access_restricted": "访问受限", "unreadable": "无法读取", "not_executed": "未执行", "not_applicable": "不适用"}},
  "gap_priority": {"values": ["P0", "P1", "P2"], "labels": {"P0": "P0", "P1": "P1", "P2": "P2"}},
  "gap_route": {"values": ["research", "user", "bounded"], "labels": {"research": "继续研究", "user": "问用户", "bounded": "有界处理"}},
  "gap_blocking": {"values": ["task", "branch", "none"], "labels": {"task": "阻塞整个任务", "branch": "阻塞分支", "none": "不阻塞"}},
  "gap_status": {"values": ["open", "researching", "waiting_user", "resolved", "unavailable"], "labels": {"open": "未处理", "researching": "研究中", "waiting_user": "等用户", "resolved": "已解决", "unavailable": "无法取得"}},
  "gap_disposition": {"values": ["non_blocking", "limits_conclusion", "blocks_completion"], "labels": {"non_blocking": "不影响", "limits_conclusion": "限制结论", "blocks_completion": "阻碍完成"}},
